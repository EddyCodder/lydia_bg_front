# Conexión al backend de Lydia (Evolution API + endpoints propios /crm/*,
# CRM-12). Copiar a .env.local y completar.
# .env.local queda git-ignorado -- nunca commitear la apikey acá.

# Interruptor: sin esto en "true", el inbox usa datos de ejemplo y ni
# siquiera intenta pegarle al backend (evita el lag de esperar un fetch
# que se sabe que va a fallar sin credenciales, o sin instancia conectada).
NEXT_PUBLIC_LYDIA_API_ENABLED=false

# URL base de Evolution API (sin / al final). En producción, dentro de la
# red Docker: http://evolution-api:8080 (mismo docker-compose.yml); desde
# afuera: https://api-crm.brittanygroup.edu.pe
EVOLUTION_API_URL=

# apikey global de Evolution API (variable EVOLUTION_API_KEY del .env de
# /lydia_prod en el VPS) -- no es un token por agente, es la clave maestra
# de la instancia.
EVOLUTION_API_KEY=

# Nombre de la instancia de WhatsApp ya conectada (creada y logueada por QR
# desde el manager de Evolution API, /manager). Sin un numero conectado no
# hay conversaciones reales que listar.
EVOLUTION_INSTANCE_NAME=
