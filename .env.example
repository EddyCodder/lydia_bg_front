# Conexión a Chatwoot (CRM-9). Copiar a .env.local y completar.
# .env.local queda git-ignorado -- nunca commitear el token acá.

# Interruptor: sin esto en "true", el inbox usa datos de ejemplo y ni
# siquiera intenta pegarle a Chatwoot (evita el lag de esperar un fetch
# que se sabe que va a fallar sin credenciales).
NEXT_PUBLIC_CHATWOOT_ENABLED=false

# URL base de la instancia de Chatwoot (sin / al final).
# Producción actual: https://chat.ragnargroup.app
CHATWOOT_BASE_URL=

# Token de agente: en Chatwoot, Perfil > Ajustes de la cuenta > Access Token.
# Es personal por agente -- no es la clave de la app ni de Evolution API.
CHATWOOT_API_TOKEN=

# ID numérico de la cuenta de Chatwoot (aparece en la URL del dashboard,
# ej. .../app/accounts/1/... -> CHATWOOT_ACCOUNT_ID=1).
CHATWOOT_ACCOUNT_ID=
